# Copy to .env and fill in. .env is git-ignored; never commit a real key.
ANTHROPIC_API_KEY=
# Model for decisions, plans, explanations and the coach chat
CLAUDE_MODEL=claude-sonnet-5-5
# Set to 0 to turn all AI text off (the coach then uses its rule-based fallbacks)
# EXPLAIN=0

# Voiceover for the 7-day learning phase (ElevenLabs). Without it, the browser's own voice is used.
ELEVENLABS_API_KEY=
# Optional: override the default voice (a premade ElevenLabs voice id)
# ELEVENLABS_VOICE_ID=

# --- Admin login. In production (NODE_ENV=production) the development defaults are refused. ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long
JWT_SECRET=change-me-to-a-long-random-string

# --- Payee shown on the coach paywall (first boot only; later edit in the admin dashboard > Settings). ---
# UPI_ID=yourname@bank
# PAYEE_NAME=Your Name

# Optional contact added to the User-Agent sent to Lichess / Chess.com.
# CONTACT_EMAIL=

# --- Only when pointing a local process (e.g. the admin dashboard) at a Render database: use the EXTERNAL URL. ---
# DATABASE_URL=postgresql://user:password@dpg-xxxx.oregon-postgres.render.com/dbname
# DATABASE_SSL=require
# REDIS_URL is only needed by the game server, which runs on Render.

# Ports (defaults shown). The admin dashboard always binds to 127.0.0.1.
# PORT=8001
# ADMIN_PORT=8003

